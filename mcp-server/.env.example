# Copia este archivo a mcp-server/.env (está en .gitignore; NUNCA subas keys reales).
# Lo que venga en el bloque "env" de claude_desktop_config.json tiene prioridad sobre este archivo.

# Misma base hosted que usa web/ (Supabase → Project Settings → API).
MCP_SUPABASE_URL=
# service_role: omite RLS. Solo en tu máquina.
MCP_SUPABASE_SERVICE_KEY=

# SHA-256 del token que manda Claude Desktop en MCP_AUTH_TOKEN. Genera ambos con:
#   npm run token
MCP_AUTH_TOKEN_SHA256=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
OPENAI_API_KEY=

# Acciones / correo
# Correo REAL solo si hay RESEND_API_KEY y ACTIONS_MODE=real (ver Gobernanza abajo).
# Sin key o con ACTIONS_MODE=mock, el envío cae a simulado y el flujo sigue igual.
# Sin dominio verificado, Resend SOLO entrega al correo de tu cuenta de Resend:
# en la demo, los candidatos/usuarios que reciben avisos deben tener ese correo.
RESEND_API_KEY=
# Remitente (opcional). Por defecto: LivHire <onboarding@resend.dev>, el remitente de
# prueba de Resend que funciona sin dominio verificado.
EMAIL_FROM="LivHire <onboarding@resend.dev>"

# Google Calendar (agendar entrevistas). Pasos de Google Cloud: src/lib/acciones/README-calendar.md
# Evento REAL solo con ACTIONS_MODE=real + estas credenciales + el AT conectó su cuenta en
# /at/entrevistas. Si falta algo, la entrevista se guarda en modo interno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Idéntica a la URI registrada en el cliente OAuth de Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# "all" envía invitación por correo a los entrevistadores; por defecto no se envía.
GOOGLE_CALENDAR_SEND_UPDATES=none

# Gobernanza
MAX_USD_DIA=10
# mock = todo simulado; real = correo con Resend y eventos en Google Calendar si hay credenciales.
ACTIONS_MODE=mock

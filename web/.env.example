# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA
OPENAI_API_KEY=

# Acciones / correo
# RESEND_API_KEY: en modo mock (ACTIONS_MODE=mock o sin esta key) NO hace falta;
# el envío de correo cae a simulado. Para envío real, pon aquí tu key de Resend.
RESEND_API_KEY=
# Remitente para Resend (opcional). Por defecto usa el sandbox onboarding@resend.dev.
RESEND_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Gobernanza
MAX_USD_DIA=10
ACTIONS_MODE=mock
